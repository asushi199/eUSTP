# === Pangkalan data (Supabase Postgres) ===
# Runtime (Vercel): guna Transaction Pooler URL (port 6543)
# Migrasi tempatan: guna Direct connection URL (port 5432)
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# === Auth.js ===
# Jana dengan: openssl rand -base64 32
AUTH_SECRET=
AUTH_TRUST_HOST=true

# Google OAuth untuk direktori (hanya @moe-dl.edu.my).
# Redirect URI: {APP_BASE_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Gemini (jana Objektif/Refleksi laporan USTP) — kunci percuma dari Google AI Studio.
# GEMINI_MODEL pilihan (default: gemini-2.5-flash).
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# === Seed ===
SEED_ADMIN_PASSWORD=

# === Gambar laporan (GAS Web App -> Google Drive) — Fasa C ===
GAS_WEB_APP_URL=
GAS_UPLOAD_SECRET=

# === Tempahan (token kelulusan + gambar bilik) — Fasa D ===
APP_BASE_URL=http://localhost:3000
ADMIN_SESSION_SECRET=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=room-photos

# === Autosijil (kehadiran + sijil) ===
# URL asas aplikasi Autosijildankehadiran (tanpa trailing slash)
AUTOSIJIL_BASE_URL=http://localhost:3001
# Rahsia sama dengan EUSTP_INTEGRATION_SECRET di Autosijil
AUTOSIJIL_INTEGRATION_SECRET=

# === Telegram Bot (notifikasi pentadbir) ===
# Cipta Bot melalui @BotFather. Jangan dedahkan token dalam kod atau log.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Jana nilai rawak; nilai sama dihantar kepada Telegram semasa setWebhook.
TELEGRAM_WEBHOOK_SECRET=
